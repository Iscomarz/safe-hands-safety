# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Delivery Routing
# Destination email(s) where quote requests will be delivered (comma-separated if multiple)
FORM_TO_EMAIL=quotes@yourdomain.com, accounting@yourdomain.com

# Sender email address (verified domain in Resend)
FORM_FROM_EMAIL=Your Company <quotes@yourdomain.com>
